<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>

        <!-- Make sure start same folder .NET Core CLI and Visual Studio -->
        <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cake.Compression" Version="0.4.0" />
        <PackageReference Include="Cake.GitVersioning" Version="3.10.94" />
        <PackageReference Include="Cake.Frosting" Version="6.3.0" />
        <PackageReference Include="Cake.Incubator" Version="11.0.0" />
        <PackageReference Include="SharpZipLib" Version="1.4.2" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />

        <PackageReference Include="GitVersion.CommandLine" Version="5.12.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
