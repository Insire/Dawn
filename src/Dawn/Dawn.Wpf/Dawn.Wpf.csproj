<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <ApplicationIcon>dawn.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Properties\licenses.json" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AdonisUI.ClassicTheme" Version="1.17.1" />
        <PackageReference Include="Octokit" Version="14.0.0" />
        <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
        <PackageReference Include="DryIoc.dll" Version="5.4.3" />
        <PackageReference Include="Jot" Version="2.1.17" />
        <PackageReference Include="MahApps.Metro.IconPacks.FontAwesome" Version="5.1.0" />
        <PackageReference Include="MvvmScarletToolkit.Wpf" Version="5.0.208" />
        <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        
        <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Dawn.Core\Dawn.Core.csproj" />
    </ItemGroup>
</Project>
