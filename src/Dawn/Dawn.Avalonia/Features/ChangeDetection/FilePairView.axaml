<UserControl x:Class="Dawn.Avalonia.Features.ChangeDetection.FilePairView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:changeDetection="clr-namespace:Dawn.Core.Features.ChangeDetection;assembly=Dawn.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:DataType="changeDetection:FilePairViewModel"
             mc:Ignorable="d">

    <Grid Margin="0 0 0 8" ColumnDefinitions="*,8,*">

        <!--  LEFT  -->
        <suki:GroupBox Grid.Column="0" Header="Source">
            <ContentControl Content="{Binding Source}" />
        </suki:GroupBox>

        <!--  RIGHT  -->
        <suki:GroupBox Grid.Column="2" Header="Destination">
            <ContentControl Content="{Binding Destination}" />
        </suki:GroupBox>
    </Grid>
</UserControl>
