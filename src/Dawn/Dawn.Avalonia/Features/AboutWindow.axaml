<suki:SukiWindow x:Class="Dawn.Avalonia.Features.AboutWindow"
                 xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="clr-namespace:Dawn.Core.Features.About;assembly=Dawn.Core"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 Title="About"
                 Width="700"
                 Height="400"
                 d:DesignHeight="450"
                 d:DesignWidth="800"
                 x:DataType="core:AboutViewModel"
                 CanMaximize="False"
                 CanMinimize="False"
                 CanResize="False"
                 WindowStartupLocation="CenterOwner"
                 mc:Ignorable="d">

    <suki:SukiWindow.Hosts>
        <suki:SukiDialogHost Name="DialogHost" />
    </suki:SukiWindow.Hosts>

    <DockPanel Margin="8">
        <TabControl>
            <TabItem Header="About">
                <DockPanel HorizontalAlignment="Center">

                    <TextBlock Margin="0 0 0 16"
                               DockPanel.Dock="Bottom"
                               TextAlignment="Center">
                        <Run Text="Author: Peter Vietense" />
                        <LineBreak />
                        <Run Text="{Binding Copyright, Mode=OneWay}" />
                        <LineBreak />

                        <Run Text="{Binding ProjectUrl, Mode=OneWay}" />

                    </TextBlock>

                    <TextBlock VerticalAlignment="Center" TextAlignment="Center">
                        <Run FontSize="24"
                             FontWeight="DemiBold"
                             Text="{Binding Product, Mode=OneWay}" />
                        <LineBreak />
                        <Run FontSize="14" Text="{Binding AssemblyVersionString, StringFormat={}v{0}, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </TabItem>

            <TabItem Header="Credits">
                <StackPanel Margin="0 16">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Top"
                               FontSize="24"
                               FontWeight="DemiBold"
                               Text="Credits"
                               TextAlignment="Center" />

                    <Grid Margin="0 8"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ColumnDefinitions="*,8,*"
                          RowDefinitions="*,*,*">

                        <TextBlock Text="Application icon:" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Source:" />
                        <TextBlock Grid.Row="1" Grid.Column="2">
                            <Run Text="{Binding IconUrl, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Author:" />
                        <TextBlock Grid.Row="2" Grid.Column="2">
                            <Run Text="{Binding IconAuthorUrl, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Dependencies">
                <DataGrid ItemsSource="{Binding Items}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding PackageId, DataType=core:PackageViewModel}" Header="Package Id" />
                        <DataGridTextColumn Binding="{Binding PackageVersion, DataType=core:PackageViewModel}" Header="Version" />
                        <DataGridCheckBoxColumn Binding="{Binding PackageProjectUrl, DataType=core:PackageViewModel}" Header="Url" />
                        <DataGridTextColumn Binding="{Binding Copyright, DataType=core:PackageViewModel}" Header="Copyright" />
                        <DataGridTextColumn Binding="{Binding Authors, DataType=core:PackageViewModel}" Header="Authors" />
                        <DataGridTextColumn Binding="{Binding License, DataType=core:PackageViewModel}" Header="License" />
                        <DataGridTextColumn Binding="{Binding LicenseUrl, DataType=core:PackageViewModel}" Header="License Url" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</suki:SukiWindow>
