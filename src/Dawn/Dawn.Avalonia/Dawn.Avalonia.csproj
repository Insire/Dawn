<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
        <ApplicationIcon>Assets\dawn.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Properties\licenses.json" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
        <PackageReference Include="HotAvalonia" Version="3.1.5" PrivateAssets="All" Publish="True" />
        <PackageReference Include="Avalonia" Version="12.1.5" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="DryIoc.dll" Version="5.4.3" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
        <PackageReference Include="SukiUI" Version="7.0.1" />
        <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    </ItemGroup>

    <ItemGroup>
        <UpToDateCheckInput Remove="Views\MainWindow.axaml" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Properties\licenses.json" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Dawn.Core\Dawn.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Assets\dawn.ico" />
      <Resource Include="Assets\dawn.ico" />
    </ItemGroup>
</Project>
