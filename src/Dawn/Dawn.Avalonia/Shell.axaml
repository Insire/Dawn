<suki:SukiWindow x:Class="Dawn.Avalonia.Shell"
                 xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:core="using:Dawn.Core"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:staging="clr-namespace:Dawn.Core.Features.Staging;assembly=Dawn.Core"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 Name="RootWindow"
                 Title="{Binding Title}"
                 Width="930"
                 Height="450"
                 MinWidth="930"
                 MinHeight="450"
                 d:DesignHeight="450"
                 d:DesignWidth="930"
                 x:CompileBindings="True"
                 x:DataType="core:ShellViewModel"
                 DragDrop.AllowDrop="True"
                 Icon="/Assets/dawn.ico"
                 mc:Ignorable="d">

    <suki:SukiWindow.Hosts>
        <suki:SukiDialogHost Name="DialogHost" />
    </suki:SukiWindow.Hosts>

    <suki:SukiWindow.KeyBindings>
        <KeyBinding Command="{Binding Stagings.AddFilesCommand}" Gesture="Ctrl+O" />
        <KeyBinding Command="{Binding Stagings.AddFolderCommand}" Gesture="Ctrl+Shift+O" />
        <KeyBinding Command="{Binding Updates.RefreshCommand}" Gesture="F5" />
        <KeyBinding Command="{Binding Stagings.ApplyCommand}" Gesture="Ctrl+Enter" />
    </suki:SukiWindow.KeyBindings>

    <suki:SukiWindow.RightWindowTitleBarControls>
        <Button Classes="WindowControlsButton"
                Click="ShowAbout"
                Focusable="True"
                HotKey="F1"
                ToolTip.Tip="About (F1)">
            <PathIcon Width="14"
                      Height="14"
                      Data="{StaticResource Icon.Info}" />
        </Button>

        <Button Classes="WindowControlsButton"
                Click="OnToggleTheme"
                Focusable="True"
                HotKey="Ctrl+T"
                ToolTip.Tip="Toggle theme (Ctrl+T)">
            <PathIcon Width="14"
                      Height="14"
                      Data="{StaticResource Icon.Paintbrush}" />
        </Button>

        <Button Classes="WindowControlsButton"
                Click="OpenConfiguration"
                Focusable="True"
                HotKey="Ctrl+OemComma"
                ToolTip.Tip="Configuration (Ctrl+,)">
            <PathIcon Width="14"
                      Height="14"
                      Data="{StaticResource Icon.Gear}" />
        </Button>

        <Button Classes="WindowControlsButton"
                Click="ShowLog"
                Focusable="True"
                HotKey="Ctrl+L"
                ToolTip.Tip="Log (Ctrl+L)">
            <PathIcon Width="14"
                      Height="14"
                      Data="{StaticResource Icon.BarsStaggered}" />
        </Button>

        <ToggleButton Padding="8 0"
                      Background="Transparent"
                      BorderThickness="0"
                      Classes="TopmostToggle"
                      Focusable="True"
                      HotKey="Ctrl+Shift+T"
                      IsCheckedChanged="ToggleButton_OnIsCheckedChanged"
                      ToolTip.Tip="Keep on top (Ctrl+Shift+T)">
            <ToggleButton.Styles>
                <Style Selector="ToggleButton.TopmostToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.TopmostToggle:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.TopmostToggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
                <Style Selector="ToggleButton PathIcon.toggle-on">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="ToggleButton:checked PathIcon.toggle-on">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="ToggleButton PathIcon.toggle-off">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="ToggleButton:checked PathIcon.toggle-off">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </ToggleButton.Styles>
            <Panel>
                <PathIcon Width="14"
                          Height="14"
                          Classes="toggle-on"
                          Data="{StaticResource Icon.ToggleOn}" />
                <PathIcon Width="14"
                          Height="14"
                          Classes="toggle-off"
                          Data="{StaticResource Icon.ToggleOff}" />
            </Panel>
        </ToggleButton>

    </suki:SukiWindow.RightWindowTitleBarControls>

    <Grid Grid.RowDefinitions="2*,*,80">
        <!--  Empty View  -->
        <DockPanel Grid.RowSpan="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsEmpty}">

            <TextBlock VerticalAlignment="Center"
                       DockPanel.Dock="Top"
                       TextAlignment="Center">
                <Run Text="This looks rather empty ..." />
                <LineBreak />
                <Run Text="Why not drop some files here?" />
            </TextBlock>

            <PathIcon Margin="8"
                      HorizontalAlignment="Center"
                      Data="{StaticResource Icon.ChevronDown}" />
        </DockPanel>

        <!--  Backups  -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="4">
            <ScrollViewer.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding Stagings.AddFilesCommand}" Header="Add files">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.Plus}" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Command="{Binding Stagings.AddFolderCommand}" Header="Add folder">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.FolderPlus}" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Command="{Binding Updates.RefreshCommand}" Header="Refresh">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.Rotate}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Command="{Binding Updates.DeleteAllCommand}" Header="Delete all backups">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.Trash}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </ScrollViewer.ContextMenu>

            <ItemsControl ItemsSource="{Binding Updates.Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!--  Staging details  -->
        <suki:GlassCard Name="StagingDetails"
                        Grid.Row="1"
                        MinHeight="80"
                        Background="{StaticResource SukiGlassCardOpaqueBackground}"
                        CornerRadius="0"
                        IsAnimated="False"
                        IsVisible="{Binding !#RootWindow.((core:ShellViewModel)DataContext).Stagings.IsEmpty}">
            <suki:GlassCard.Resources />

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Stagings.Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type staging:StagingViewModel}">
                            <DockPanel Margin="0 4 0 0" HorizontalAlignment="Stretch">
                                <PathIcon VerticalAlignment="Center"
                                          Data="{StaticResource Icon.File}"
                                          DockPanel.Dock="Left" />
                                <Button Command="{Binding #RootWindow.((core:ShellViewModel)DataContext).Stagings.RemoveCommand}"
                                        CommandParameter="{Binding}"
                                        DockPanel.Dock="Right"
                                        ToolTip.Tip="Unstage this">
                                    <PathIcon Data="{StaticResource Icon.Trash}" />
                                </Button>

                                <TextBlock Margin="8 0"
                                           VerticalAlignment="Center"
                                           Text="{Binding FullPath}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </suki:GlassCard>

        <!--  Staging bar  -->
        <suki:GlassCard Name="StagingBar"
                        Grid.Row="2"
                        Margin="0"
                        Background="{StaticResource SukiGlassCardOpaqueBackground}"
                        CornerRadius="0"
                        IsAnimated="False"
                        IsVisible="{Binding !#RootWindow.((core:ShellViewModel)DataContext).Stagings.IsEmpty}">
            <suki:GlassCard.Resources />

            <DockPanel>
                <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding #RootWindow.StagingChecked, Mode=TwoWay}">
                    <ToggleButton.Styles>
                        <Style Selector="PathIcon.IsToggled">
                            <Setter Property="Data" Value="{StaticResource Icon.ChevronUp}" />
                        </Style>
                        <Style Selector="PathIcon.IsNotToggled">
                            <Setter Property="Data" Value="{StaticResource Icon.ChevronDown}" />
                        </Style>
                    </ToggleButton.Styles>

                    <PathIcon Classes.IsNotToggled="{Binding !#RootWindow.StagingChecked}" Classes.IsToggled="{Binding #RootWindow.StagingChecked}" />
                </ToggleButton>

                <Button Command="{Binding Stagings.ApplyCommand}"
                        DockPanel.Dock="Right"
                        ToolTip.Tip="Apply Updates (Ctrl+Enter)">
                    <PathIcon Data="{StaticResource Icon.FileArrowUp}" />
                </Button>

                <Button Margin="8 0"
                        Command="{Binding Stagings.ClearCommand}"
                        DockPanel.Dock="Right"
                        ToolTip.Tip="Unstage everything">
                    <PathIcon Data="{StaticResource Icon.Trash}" />
                </Button>

                <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Stagings.ReuseLastBackup}" />
                <TextBlock VerticalAlignment="Center"
                           DockPanel.Dock="Right"
                           Text="Reuse latest Backup" />

                <TextBlock VerticalAlignment="Center" Text="{Binding Stagings.Items.Count, StringFormat='{} Staging Area ({0} Files)'}" />
            </DockPanel>
        </suki:GlassCard>
    </Grid>
</suki:SukiWindow>
